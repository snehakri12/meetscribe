# Database. Defaults to SQLite (backend/fireflies.db) when unset.
# For Postgres (e.g. Neon) use: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./fireflies.db

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seed the demo meetings automatically when the database is empty.
SEED_ON_STARTUP=true
